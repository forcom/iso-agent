{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "jsx": "react-jsx", "esModuleInterop": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
