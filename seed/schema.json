{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iso-agent.superhot.company/seed/schema.json",
  "title": "iso-agent seed",
  "type": "object",
  "required": ["meta"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["ontology_revision"],
      "properties": {
        "ontology_revision": { "type": "string" },
        "generated_by": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "source_ref": { "type": "string" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "subject_types", "object_types"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "subject_types": { "type": "array", "items": { "type": "string" } },
          "object_types": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "predicate", "object"],
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "predicate": { "type": "string" },
          "object": { "type": "string" },
          "quote": { "type": "string" },
          "source_document_id": { "type": "string" },
          "revision": { "type": "string" },
          "status": { "enum": ["draft", "approved"] }
        }
      }
    },
    "wiki_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "claims"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["draft", "approved"] },
          "claims": { "type": "array" },
          "links": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
